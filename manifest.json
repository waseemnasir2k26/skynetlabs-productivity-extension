{
  "manifest_version": 3,
  "name": "Skynetlabs Productivity",
  "version": "3.0.0",
  "description": "Productivity Chrome Extension by Skynetlabs - Focus mode, task management, floating notes, and site blocking. Free forever.",
  "author": "Skynetlabs | skynetjoe.com",

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Skynetlabs Productivity"
  },

  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/floating-notes.js"],
      "run_at": "document_idle"
    }
  ],

  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },

  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "idle",
    "tabs",
    "offscreen",
    "sidePanel",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "activeTab",
    "contextMenus",
    "scripting",
    "tabGroups",
    "webNavigation"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "focus_blocking_rules",
        "enabled": false,
        "path": "rules/blocking_rules.json"
      }
    ]
  },

  "web_accessible_resources": [
    {
      "resources": [
        "focus.html",
        "blocked.html",
        "sidepanel.html",
        "css/*",
        "js/*",
        "icons/*",
        "assets/*",
        "audio/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "Open Skynetlabs Productivity"
    },
    "toggle_focus": {
      "suggested_key": {
        "default": "Alt+F",
        "mac": "Alt+F"
      },
      "description": "Toggle Focus Mode"
    },
    "quick_task": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "Alt+T"
      },
      "description": "Quick Add Mission"
    },
    "toggle_floating_notes": {
      "suggested_key": {
        "default": "Ctrl+Shift+N",
        "mac": "Command+Shift+N"
      },
      "description": "Toggle Floating Notes"
    }
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },

  "minimum_chrome_version": "121"
}
